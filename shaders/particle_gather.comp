#version 450
// GPU particles sorted back to front (renderer_particles.cpp): the see-through ones copied into the draw list in
// their keys' order, after the sort (particle_sort.comp)
layout(local_size_x = 64) in;
struct Draw {
    vec4 posSize, color, streak;
};
struct DrawCommand { uint vertexCount, instanceCount, firstVertex, firstInstance; };
layout(std430, set = 1, binding = 2) writeonly buffer Draws { Draw draws[]; };
layout(std430, set = 1, binding = 3) readonly buffer Indirect { DrawCommand commands[2]; } indirect;
layout(std430, set = 1, binding = 4) readonly buffer Unsorted { Draw unsorted[]; };
layout(std430, set = 1, binding = 5) readonly buffer Keys { uvec2 keys[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= indirect.commands[0].instanceCount) return;
    draws[indirect.commands[0].firstInstance + i] = unsorted[keys[i].y];
}
