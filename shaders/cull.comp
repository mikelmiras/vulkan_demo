#version 450
// GPU culling: one invocation per solid object of the main pass. Each that's (partly) inside the view frustum and,
// with occlusion culling on, not hidden behind what the last frame drew (its depth pyramid, through that frame's
// camera), gets the next slot of its batch's indirect draw for the level of detail it needs (from how much of
// the view it covers) and its instance written there, so the draws read only the visible ones
// (instances[instanceIndex[gl_InstanceIndex]]).

layout(local_size_x = 64) in;

struct Bounds {
    vec4 centre;   // world-space centre of its box; w: its batch (the bits of a uint)
    vec4 extent;   // world-space half extents; w > 0: never culled (skinned: it goes where its skeleton takes it)
    uvec4 info;    // x: its instance, y: the levels of detail its mesh has
};
layout(std430, set = 0, binding = 0) readonly buffer BoundsBuffer { Bounds bounds[]; };
struct DrawCommand {   // VkDrawIndexedIndirectCommand
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};
layout(std430, set = 0, binding = 1) buffer Commands { DrawCommand commands[]; };   // three per batch: its levels
layout(std430, set = 0, binding = 2) writeonly buffer Indices { uint instanceIndex[]; };
layout(std140, set = 0, binding = 3) uniform Params {
    vec4 planes[6];     // the frustum, inside where dot(n, p) + d >= 0 (not normalised)
    vec4 camPos;        // w: tan(fovY / 2)
    uvec4 counts;       // x: objects (bounds[i]); y: 1 = occlusion culling (the pyramid is from a frame before)
    vec4 lodSizes;      // x, y: the view fractions below which levels 1 and 2 are used
    mat4 prevViewProj;  // the camera the pyramid was drawn with
    ivec4 hiz;          // its level 0's size, its levels
} params;
layout(set = 0, binding = 4) uniform sampler2D pyramid;

// Hidden behind the depth pyramid? (false whenever unsure: partly off that frame's screen, or behind its camera)
bool occluded(vec3 c, vec3 e) {
    vec2 lo = vec2(1e9), hi = vec2(-1e9);
    float nearest = 1.0;
    for (int k = 0; k < 8; ++k) {
        vec3 p = c + e * vec3((k & 1) != 0 ? 1.0 : -1.0, (k & 2) != 0 ? 1.0 : -1.0, (k & 4) != 0 ? 1.0 : -1.0);
        vec4 clip = params.prevViewProj * vec4(p, 1.0);
        if (clip.w <= 1e-3) return false;
        vec3 ndc = clip.xyz / clip.w;
        vec2 uv = ndc.xy * 0.5 + 0.5;
        lo = min(lo, uv);
        hi = max(hi, uv);
        nearest = min(nearest, ndc.z);
    }
    if (lo.x < 0.0 || lo.y < 0.0 || hi.x > 1.0 || hi.y > 1.0 || nearest < 0.0) return false;
    // The level where the box covers at most 2 x 2 texels (one texel of slack: the pyramid was drawn jittered)
    vec2 texels = (hi - lo) * vec2(params.hiz.xy) + 2.0;
    int level = clamp(int(ceil(log2(max(texels.x, texels.y)))), 0, params.hiz.z - 1);
    ivec2 size = max(params.hiz.xy >> level, ivec2(1));
    ivec2 a = clamp(ivec2(lo * vec2(size)) - 1, ivec2(0), size - 1), b = clamp(ivec2(hi * vec2(size)), ivec2(0), size - 1);
    float farthest = 0.0;
    for (int y = a.y; y <= b.y; ++y)
        for (int x = a.x; x <= b.x; ++x) farthest = max(farthest, texelFetch(pyramid, ivec2(x, y), level).r);
    return nearest > farthest;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.counts.x) return;
    Bounds b = bounds[i];
    int lod = 0;
    if (b.extent.w <= 0.0) {
        for (int k = 0; k < 6; ++k) {
            vec4 p = params.planes[k];
            if (dot(p.xyz, b.centre.xyz) + p.w + dot(abs(p.xyz), b.extent.xyz) < 0.0) return;   // all outside this one
        }
        if (params.counts.y != 0u && occluded(b.centre.xyz, b.extent.xyz)) return;
        float size = length(b.extent.xyz) / max(distance(b.centre.xyz, params.camPos.xyz) * params.camPos.w, 1e-6);
        lod = min(size < params.lodSizes.y ? 2 : size < params.lodSizes.x ? 1 : 0, int(b.info.y));
    }
    uint command = floatBitsToUint(b.centre.w) * 3u + uint(lod);
    uint slot = atomicAdd(commands[command].instanceCount, 1u);
    instanceIndex[commands[command].firstInstance + slot] = b.info.x;
}
