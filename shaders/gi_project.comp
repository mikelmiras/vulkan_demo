#version 450
// Dynamic GI: the probes drawn this frame (six faces each, a row of the atlas per probe) projected onto the first
// nine spherical harmonics and convolved with the cosine lobe (as environment.cpp does for sky images), blended
// into their slots in the probe buffer. One workgroup per probe.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform sampler2D faces;   // RGBA16F: probe p's face f at (f * size, p * size)
layout(std430, set = 0, binding = 1) buffer Probes { vec4 probes[]; };   // per slot: position (w = 1: made), 9 SH
layout(set = 0, binding = 2) uniform Dispatch {
    vec4 probe[4];      // xyz = where it is, w = its slot
    vec4 blend[4];      // x = how much of the new picture to take (1: all of it)
    vec4 face[6][3];    // per face: the direction through its centre, and per unit of NDC x and y
    ivec4 info;         // x = face size (pixels)
} dispatchInfo;

shared vec4 sums[64][9];   // rgb = sum of colour * basis * weight; [0].a = sum of weights

void basis(vec3 d, out float y[9]) {
    y[0] = 0.282095;
    y[1] = 0.488603 * d.y;
    y[2] = 0.488603 * d.z;
    y[3] = 0.488603 * d.x;
    y[4] = 1.092548 * d.x * d.y;
    y[5] = 1.092548 * d.y * d.z;
    y[6] = 0.315392 * (3.0 * d.z * d.z - 1.0);
    y[7] = 1.092548 * d.x * d.z;
    y[8] = 0.546274 * (d.x * d.x - d.y * d.y);
}

void main() {
    uint p = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    int size = dispatchInfo.info.x;
    for (int k = 0; k < 9; ++k) sums[t][k] = vec4(0.0);
    int texels = 6 * size * size;
    for (int i = int(t); i < texels; i += 64) {
        int f = i / (size * size), rest = i % (size * size);
        int x = rest % size, y = rest / size;
        vec2 ndc = (vec2(x, y) + 0.5) / float(size) * 2.0 - 1.0;
        vec3 d = dispatchInfo.face[f][0].xyz + ndc.x * dispatchInfo.face[f][1].xyz + ndc.y * dispatchInfo.face[f][2].xyz;
        float len = length(d);
        float w = 1.0 / (len * len * len);   // (a texel's solid angle on a cube face, up to a constant)
        vec3 c = texelFetch(faces, ivec2(f * size + x, int(p) * size + y), 0).rgb;
        float b[9];
        basis(d / len, b);
        for (int k = 0; k < 9; ++k) sums[t][k].rgb += c * b[k] * w;
        sums[t][0].a += w;
    }
    barrier();
    for (uint s = 32; s > 0; s >>= 1) {
        if (t < s)
            for (int k = 0; k < 9; ++k) sums[t][k] += sums[t + s][k];
        barrier();
    }
    if (t == 0) {
        const float kPi = 3.14159265;
        const float band[9] = float[9](kPi, 2.0 * kPi / 3.0, 2.0 * kPi / 3.0, 2.0 * kPi / 3.0, kPi / 4.0, kPi / 4.0,
                                       kPi / 4.0, kPi / 4.0, kPi / 4.0);
        float scale = 4.0 * kPi / max(sums[0][0].a, 1e-6);   // (the weights cover the whole sphere)
        uint slot = uint(dispatchInfo.probe[p].w), o = slot * 10u;
        float keep = 1.0 - dispatchInfo.blend[p].x;
        for (int k = 0; k < 9; ++k) {
            vec3 c = sums[0][k].rgb * scale * band[k];
            probes[o + 1u + uint(k)] = vec4(mix(c, probes[o + 1u + uint(k)].rgb, keep), 0.0);
        }
        probes[o] = vec4(dispatchInfo.probe[p].xyz, 1.0);
    }
}
